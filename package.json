{
  "name": "mdview",
  "version": "1.3.0",
  "description": "Markdown editor and Excalidraw viewer with live preview, editable Mermaid diagrams, search and export to PDF or Word",
  "author": "Daud",
  "desktopName": "mdview.desktop",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "npm run build:assets && npm run build:vendor",
    "build:assets": "node tools/copy-assets.js",
    "build:vendor": "esbuild src/vendor-entry.js --bundle --format=iife --global-name=MDV --minify --target=chrome120 --conditions=production --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --outfile=src/renderer/vendor/vendor.js && node tools/patch-vendor.js",
    "build:icons": "electron tools/make-icons.js && python3 tools/downscale.py",
    "build:platform-icons": "node tools/make-platform-icons.js",
    "dist": "npm run build && node tools/make-platform-icons.js && electron-builder",
    "dist:win": "npm run build && node tools/make-platform-icons.js && electron-builder --win",
    "dist:linux": "npm run build && node tools/make-platform-icons.js && electron-builder --linux",
    "postinstall": "node tools/copy-assets.js",
    "install:desktop": "./install.sh",
    "uninstall:desktop": "./uninstall.sh"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.23.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "lz-string": "^1.5.0",
    "marked": "^15.0.7",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
